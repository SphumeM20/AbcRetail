@model Customer
@{
    ViewData["Title"] = "Add Customer";
}

<h1>Add Customer</h1>

<form asp-action="Create" method="post">
    <div class="mb-3"><label class="form-label">Customer ID</label><input asp-for="CustomerId" class="form-control" placeholder="C006" /></div>
    <div class="mb-3"><label class="form-label">Name</label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Email</label><input asp-for="Email" class="form-control" type="email" /></div>
    <div class="mb-3"><label class="form-label">Phone</label><input asp-for="Phone" class="form-control" /></div>
    <button class="btn btn-primary" type="submit">Save Customer</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
